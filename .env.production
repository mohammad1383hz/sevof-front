# Sevof panel: production server values (copy to .env or .env.production before `npm run build`).
# For local development use http://127.0.0.1:8000 for both URLs instead.
VITE_API_BASE_URL=https://api.sevof.com
VITE_UPLOADS_URL=https://api.sevof.com

# Google sign-in: Sevof's own OAuth client (must match GOOGLE_CLIENT_ID in the backend .env)
VITE_GOOGLE_CLIENT_ID=489943732654-ltaur2unnvdjo317ipp7chfhhihe1d5h.apps.googleusercontent.com

# WordPress.org page of the Sevof plugin (falls back to /downloads/wordpress-plugin.zip)
VITE_WP_PLUGIN_PAGE_URL=
